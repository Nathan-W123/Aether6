# ---------------------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------------------
build/
build-*/
cmake-build-*/
compile_commands.json
*.o
*.a
*.so

# ---------------------------------------------------------------------------------------
# Generated simulation logs.
#
# The *figures* and the small summary/analysis files under results/ ARE committed, so the
# repository ships reproducible example outputs. The bulk time-series logs are not: a single
# 300 s run writes ~13 MB of CSV, and `make run-all` regenerates all of it in a few minutes.
# ---------------------------------------------------------------------------------------
results/*/states.csv
results/*/sensor_*.csv
results/monte_carlo/trajectories.csv
results/monte_carlo/nominal_trial/

# ---------------------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------------------
# Shareable renders.
#
# The stills are committed, as the figures are. The video is not: 17 MB of regenerable binary
# against a repository whose whole history is 18 MB. `make plate` rebuilds all of it.
# ---------------------------------------------------------------------------------------
media/plate/node_modules/

results/media/*.mp4
results/media/*.gif

# ---------------------------------------------------------------------------------------
# Web dashboard
#
# The lockfile is committed so `npm ci` and the Docker build are reproducible; the installed
# tree and the built bundle are not. `make dashboard` regenerates both.
# ---------------------------------------------------------------------------------------
node_modules/
web/frontend/dist/
.pytest_cache/
*.tsbuildinfo

# ---------------------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
